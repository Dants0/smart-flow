# Configuração do PB Insight rodando SEM Docker (`npm run serve`).
# Copie para `.env` (que o git ignora) e ajuste.
#
# Na stack Docker nada aqui é lido: as variáveis chegam pelo compose, e a porta
# vem de PB_INSIGHT_PORT no .env da raiz.

# Porta do serviço HTTP. 3000 é do web (Next), 3333 do backend, 8070 do
# app_trace — por isso o padrão aqui é 4500.
PORT=4500
HOST=0.0.0.0

# Modelo usado pelo /diagnose com provider anthropic (o padrão).
PB_INSIGHT_MODEL=claude-sonnet-5

# Preencha para usar --provider openai / "provider": "openai" no /diagnose,
# e para calcular os embeddings da busca por chamados parecidos.
OPENAI_API_KEY=
PB_INSIGHT_OPENAI_MODEL=gpt-4o-mini
