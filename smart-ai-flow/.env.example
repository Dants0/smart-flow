# Token CORPORATIVO — vive só no backend, nunca na máquina do dev
ANTHROPIC_API_KEY=sk-ant-...
MODEL=claude-sonnet-5

# Provider do pipeline principal (ANALISE/DESENVOLVIMENTO): 'anthropic' (default) ou 'openai'
AI_PROVIDER=anthropic
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
DATABASE_URL=postgresql://smart:smart@localhost:5432/smart_ai_flow
PORT=3333

# Microserviço app_trace (Go) — análise de logs de trace DB/PowerBuilder
TRACE_SERVICE_URL=http://localhost:8070

# Jira Server/DC — Basic Auth (essa versão é anterior a Personal Access Tokens)
JIRA_BASE_URL=https://seu-jira.exemplo.com
JIRA_USER=seu.usuario
JIRA_PASSWORD=sua_senha
# JQL usado pra detectar chamados novos atribuídos a você (ver GET /jira/pending)
JIRA_ASSIGNED_JQL=assignee = currentUser() AND resolution = Unresolved ORDER BY created DESC

# PB Insight (projeto separado, pasta pb-insight/) — grafo real do SMART Desktop
# indexado (15k+ objetos), usado pelo RAG em pbInsight.ts. Suba com `npm run serve`
# dentro de pb-insight/ (porta configurada no .env dele).
PB_INSIGHT_URL=http://127.0.0.1:4500
