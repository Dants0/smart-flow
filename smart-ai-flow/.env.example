# Bootstrap: o processo precisa disto antes de conseguir falar com o banco,
# então não tem como virar configuração-no-banco.
DATABASE_URL=postgresql://smart:smart@localhost:5432/smart_ai_flow

# Porta do backend rodando SEM Docker (`npm run dev`). Na stack Docker quem
# manda é BACKEND_PORT no .env da raiz — o Compose precisa do valor lá pra
# montar o mapeamento de portas, e não consegue ler este arquivo. Mantenha os
# dois iguais, senão o front aponta pra uma porta onde não tem ninguém.
PORT=3333

# JWT_SECRET assina os tokens de sessão.
# ENCRYPTION_KEY cifra a senha do Jira de cada usuário (AES-256-GCM).
# Gere os dois com:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Trocar ENCRYPTION_KEY invalida as senhas do Jira já salvas (cada dev reconfigura a dele).
JWT_SECRET=
ENCRYPTION_KEY=

# Todo o resto (chaves Anthropic/OpenAI, provider ativo, URL do Jira, URL do
# app_trace e do PB Insight) mora na tabela PlatformSettings — configure pela
# tela de Configurações da plataforma, sem reiniciar o backend.
# As credenciais pessoais do Jira ficam no perfil de cada usuário.
