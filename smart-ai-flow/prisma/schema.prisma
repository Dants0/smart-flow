// Modelo de dados da esteira. O histórico é first-class: governança
// e auditoria dependem de saber quem moveu o quê, quando e quanto custou.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Stage {
  NOVO
  ANALISE
  DESENVOLVIMENTO
  REVISAO
  VERSIONAMENTO
  RESOLVIDO
  ERRO
}

// Dev que usa a plataforma. As credenciais do Jira são POR USUÁRIO — sem isso,
// `assignee = currentUser()` resolveria pra uma conta única e todo mundo veria
// os chamados da mesma pessoa. A senha do Jira é guardada cifrada (AES-256-GCM,
// ver infra/crypto.ts) porque precisa ser reversível pro Basic Auth.
model User {
  id           String  @id @default(uuid())
  username     String  @unique
  displayName  String
  passwordHash String // scrypt, formato "salt:hash"
  isAdmin      Boolean @default(false)

  // Conta criada por um admin nasce com senha provisória, combinada por fora
  // (chat/e-mail). Até o dono trocar, a plataforma cobra a troca no primeiro acesso.
  mustChangePassword Boolean @default(false)

  jiraUser        String?
  jiraPasswordEnc String?

  // Jira Server arma um CAPTCHA depois de N logins falhados e passa a negar até
  // a senha certa. Como o board consulta o Jira a cada 60s, uma credencial
  // errada vira uma máquina de rearmar esse bloqueio no servidor da empresa —
  // e o dev destrava pelo navegador só pra travar de novo minutos depois.
  // Marcado aqui, o backend PARA de tentar até o dev regravar a senha.
  jiraAuthBlockedAt     DateTime?
  jiraAuthBlockedReason String?

  // Identidade e credencial do Bitbucket, por usuário: o commit e o PR são DELE,
  // não de um robô da plataforma. A app password é cifrada (mesmo esquema da
  // senha do Jira — precisa ser reversível pro Basic Auth do git/API).
  gitName                 String?
  gitEmail                String?
  bitbucketUser           String?
  bitbucketAppPasswordEnc String?

  cards           Card[]
  dismissedIssues DismissedIssue[]
  history         History[]
  chatMessages    ChatMessage[]

  createdAt DateTime @default(now())
}

// Aviso de "chamado atribuído a você" que o dev dispensou. Por usuário e
// persistido — antes era um Set em memória, global e perdido a cada restart.
model DismissedIssue {
  id      String   @id @default(uuid())
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId  String
  jiraKey String
  at      DateTime @default(now())

  @@unique([userId, jiraKey])
}

model Card {
  id         String @id @default(uuid())
  jiraKey    String
  module     String
  rawTicket  String
  // O que o DEV já sabe: query suspeita, DataWindow específica, objeto que ele
  // desconfia. Vale mais que qualquer palpite do modelo — quem escreveu isso
  // tem o sistema na frente. Entra no prompt E na busca de código.
  devHints   String?
  images     Json? // CardImage[] (screenshots em base64 anexados ao chamado)
  traceFiles Json? // CardTraceFile[] (logs de trace anexados)
  stage      Stage  @default(NOVO)

  // artefatos da IA, guardados como JSON validado pelos contratos Zod
  analysis      Json?
  proposal      Json?
  traceAnalysis Json? // TraceFileAnalysis[] — diagnóstico do microserviço app_trace

  // false = a análise rodou sem contexto de código (pb-insight fora do ar).
  // Sem isso, uma análise sem grounding parece tão confiante quanto uma com.
  grounded Boolean @default(true)

  // Caminhos que o diff cita e que NÃO existem no repositório. Não vazio = o
  // modelo inventou arquivo (aconteceu no SMART-50927) e o card precisa avisar.
  unknownPaths Json?

  // O que o dev REALMENTE aplicou. Pode divergir do diff proposto pela IA —
  // é este texto que vai pra base de conhecimento do pb-insight no RESOLVIDO,
  // senão a base aprende a solução errada e piora com o tempo.
  resolutionText String?

  // Aplicação do diff no working copy (ação do dev em REVISAO). appliedFiles
  // e appliedBackupDir são o que torna a operação reversível pela UI: sem eles,
  // desfazer só pelo controle de versão.
  appliedAt        DateTime?
  appliedFiles     Json? // string[] — caminhos relativos à raiz do working copy
  appliedBackupDir String?

  // Versionamento: o que foi de fato pro repositório e pro Jira.
  branch          String? // bug/SMART-XXXXX
  commitHash      String?
  committedFiles  Json? // string[] — subconjunto de appliedFiles que entrou no commit
  prUrl           String?
  jiraCommentAt   DateTime?

  createdBy   User?   @relation(fields: [createdById], references: [id])
  createdById String?

  history History[]
  runs    Run[]
  jobs    Job[]
  chat    ChatMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([module, stage])
}

model History {
  id     String @id @default(uuid())
  card   Card   @relation(fields: [cardId], references: [id], onDelete: Cascade)
  cardId String
  from   Stage
  to     Stage
  by     String // 'IA' | 'DEV'

  // QUAL dev — sem isto o histórico só dizia "um dev rejeitou o diff", que é
  // rastreabilidade inútil num time. Null quando a transição foi da IA, ou em
  // cards anteriores a este campo.
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId String?

  note String?
  at   DateTime @default(now())
}

// Fila de processamento. O pipeline de IA saiu de dentro do request HTTP:
// POST /cards enfileira e responde na hora, um worker in-process consome.
// Resolve também o card zumbi — job RUNNING órfão (processo morreu no meio)
// volta pra PENDING no startup, em vez do card ficar preso para sempre.
enum JobStatus {
  PENDING
  RUNNING
  DONE
  FAILED
}

model Job {
  id        String    @id @default(uuid())
  card      Card      @relation(fields: [cardId], references: [id], onDelete: Cascade)
  cardId    String
  status    JobStatus @default(PENDING)
  attempts  Int       @default(0)
  lastError String?
  payload   Json? // TraceProviderOverride, quando o dev usou chave pessoal

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
}

// Configuração da plataforma — linha única (id sempre 1), editável pela tela
// de Configurações. Substitui o .env pra tudo que não é bootstrap: DATABASE_URL,
// PORT e ENCRYPTION_KEY continuam no .env porque o processo precisa deles antes
// de conseguir falar com o banco / decifrar qualquer coisa.
model PlatformSettings {
  id Int @id @default(1)

  anthropicApiKey String?
  model           String  @default("claude-sonnet-5")

  aiProvider   String  @default("anthropic") // 'anthropic' | 'openai'
  openaiApiKey String?
  openaiModel  String  @default("gpt-4o")

  traceServiceUrl String @default("http://localhost:8070")

  // jiraUser/jiraPassword saíram daqui: agora são por usuário (ver model User).
  jiraBaseUrl     String?
  jiraAssignedJql String  @default("assignee = currentUser() AND resolution = Unresolved ORDER BY created DESC")

  pbInsightUrl String @default("http://127.0.0.1:4500")

  // Skill do time: procedimento colado pelo dev em Configurações > IA, entra no
  // prompt de ANALISE e DESENVOLVIMENTO. Texto livre (markdown), sem formato
  // imposto — null = nenhuma skill, e a esteira roda como antes.
  skills String?

  updatedAt DateTime @updatedAt
}

// Conversa do dev com a IA sobre um card. Persistida porque a dúvida e a
// resposta fazem parte da história da resolução: quem revisar o card depois
// precisa ver o que foi perguntado, e o consumo já é auditado em Run.
model ChatMessage {
  id      String   @id @default(uuid())
  card    Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  cardId  String
  role    String // 'user' | 'assistant'
  content String
  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId  String?
  at      DateTime @default(now())

  @@index([cardId, at])
}

// Registro de cada chamada à API — base pra controle de custo e auditoria.
// É o que sustenta a decisão de arquitetura "o token vive só no backend":
// sem isto preenchido, não existe auditoria de consumo nenhuma.
model Run {
  id           String   @id @default(uuid())
  card         Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  cardId       String
  stage        Stage
  provider     String // 'anthropic' | 'openai'
  model        String
  inputTokens  Int
  outputTokens Int
  costUsd      Float    @default(0)
  ok           Boolean
  errorMessage String?
  at           DateTime @default(now())

  @@index([at])
}
