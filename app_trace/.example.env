OPENAI_API_KEY=sua_chave_aqui_sem_aspas
GEMINI_API_KEY=sua_chave_gemini
AI_PROVIDER=gemini # ou 'openai' ou 'copilot'
AZURE_OPENAI_ENDPOINT=https://sua-empresa.openai.azure.com/
AZURE_OPENAI_KEY=sua_chave_azure_openai

# Porta do serviço rodando SEM Docker (`go run .`). Aceita "8070" ou ":8070" —
# o gin exige o dois-pontos, e o código põe sozinho quem esquecer (main.go).
# Na stack Docker quem manda é TRACE_PORT no .env da raiz.
PORT=8070
