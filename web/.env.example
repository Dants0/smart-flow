# Configuração do front rodando SEM Docker (`npm run dev`). Copie para
# `.env.local`, que é o arquivo que o Next carrega (e que o git ignora).
#
# Na stack Docker nada aqui é lido: as duas variáveis chegam pelo compose, a
# partir de WEB_PORT e BACKEND_PORT no .env da raiz.

# Porta em que o Next sobe. Mude se 3000 já estiver ocupada na sua máquina.
PORT=3000

# Onde o navegador procura a API. Tem que bater com a porta do backend
# (PORT do smart-ai-flow/.env, ou BACKEND_PORT do .env da raiz).
NEXT_PUBLIC_API_URL=http://localhost:3333
